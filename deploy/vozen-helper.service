# Serviço systemd do Vozen Helper. Mantém o bot ligado 24/7 no VPS (mesma máquina
# do Vozen, serviço SEPARADO). Copia para /etc/systemd/system/vozen-helper.service.
#
# Ajusta WorkingDirectory se clonares para outro sítio.

[Unit]
Description=Vozen Helper — Discord moderation bot
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=vozen
WorkingDirectory=/home/vozen/vozen-helper
ExecStart=/usr/bin/npm run start:prod
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
