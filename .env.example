# ─── Vozen Helper — bot de moderação privado (single-guild) ──────────────────
# Copia este ficheiro para `.env` e preenche. NUNCA commitar o `.env`.

# Token do bot (Discord Developer Portal -> Bot). OBRIGATÓRIO.
DISCORD_TOKEN=
# Application/Client ID (Developer Portal -> General Information). OBRIGATÓRIO.
CLIENT_ID=
# ID do ÚNICO servidor onde o bot pode operar. O bot sai de qualquer outra guild.
# OBRIGATÓRIO. (Ativa o "modo dev": os comandos são registados só neste guild,
# aparecem instantaneamente.)
GUILD_ID=
# Caminho da base de dados SQLite. Default: ./vozen-helper.db
DB_PATH=./vozen-helper.db
# Nível mínimo de log: debug | info | warn | error (default: info)
LOG_LEVEL=info

# ─── API do painel (processo separado do bot) ────────────────────────────────
# Só necessárias para correr a API (`npm run start:api`), não para o bot.
# Única conta Discord autorizada a usar o painel. OBRIGATÓRIO (para a API).
PANEL_ALLOWED_USER_ID=
# Segredo para assinar o cookie de sessão. OBRIGATÓRIO. >= 32 chars aleatórios.
# Gera um: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PANEL_SESSION_SECRET=
# Porta local da API (default 8788). Só o túnel lhe acede (ouve em 127.0.0.1).
PANEL_API_PORT=8788
# Origin do site autorizado no CORS (default: https://rexy40407.github.io)
PANEL_ALLOWED_ORIGIN=https://rexy40407.github.io
# Rust runtime (multi-guild public Helper)
DISCORD_APPLICATION_ID=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://api.vozen.org/rust/api/oauth/callback
HELPER_OAUTH_SUCCESS_REDIRECT=https://rexy40407.github.io/painel/
HELPER_DATABASE_URL=data/vozen-helper.sqlite
HELPER_BIND_ADDR=127.0.0.1:3101
HELPER_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Keep false in production; direct Discord token sessions are legacy-only.
HELPER_ALLOW_LEGACY_SESSION=false
HELPER_ALLOWED_ORIGIN=https://rexy40407.github.io
VOZEN_ENTITLEMENT_URL=https://api.vozen.org/internal/v1/entitlements/resolve
VOZEN_ENTITLEMENT_SECRET=
# Official YouTube Data API v3 key (server-side only; never expose in the panel).
YOUTUBE_API_KEY=
# Official Twitch Helix/EventSub credentials (server-side only; never expose in the panel).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=
TWITCH_EVENTSUB_CALLBACK_URL=https://api.vozen.org/rust/api/providers/twitch/eventsub
# Backwards-compatible alias accepted by the runtime.
TWITCH_CALLBACK_URL=
# Official Reddit OAuth app-only credentials (server-side only).
# Reddit commercial/API approval is required before enabling delivery.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=VozenHelper/1.0 by your-reddit-account
REDDIT_COMMERCIAL_APPROVED=false
# Official Meta Graph API for an authorised professional Instagram account.
META_INSTAGRAM_ACCESS_TOKEN=
META_INSTAGRAM_USER_ID=
META_GRAPH_API_BASE_URL=https://graph.facebook.com/v22.0
META_APP_APPROVED=false
# Official X API bearer token.  X_API_APPROVED must only be set after the
# account has an approved developer app and an enabled billing budget.
X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com
X_API_APPROVED=false
# Official TikTok Display API token for a creator who explicitly authorised
# Vozen.  Never use scraping or a public profile URL as a substitute.
TIKTOK_ACCESS_TOKEN=
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
TIKTOK_APP_APPROVED=false
# Official Kick Public API credentials and approval flag.
KICK_ACCESS_TOKEN=
KICK_API_BASE_URL=https://api.kick.com/public/v1
KICK_APP_APPROVED=false
# Stripe Connect is kept separate from the existing Vozen checkout. Do not
# enable until KYC, tax, refunds and support policies are approved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_APPROVED=false

# Optional Web3 integrations (server-side only; never expose these in the panel).
# CoinGecko is public without a key; set this for the higher rate limits.
COINGECKO_API_KEY=
# Gas tracker accepts only HTTPS JSON-RPC endpoints for the allow-listed networks.
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
# OpenSea read-only collection stats/sales require a production API key.
OPENSEA_API_KEY=
# Wallet gating is read-only: SIWE verifies a wallet signature and the worker
# reads balances through an approved RPC. Never put private keys here.
SIWE_DOMAIN=
SIWE_URI=https://rexy40407.github.io/painel/
SIWE_SESSION_SECRET=
SIWE_ALLOWED_CONTRACTS=
